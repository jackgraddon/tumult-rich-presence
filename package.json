{
    "name": "tumult-rich-presence",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Tumult plugin: Discord-style rich presence over MSC4133 extended profiles.",
    "scripts": {
        "build": "vite build",
        "typecheck": "vue-tsc -p tsconfig.json --noEmit",
        "shim": "node scripts/gen-vue-shim.mjs",
        "release:dry": "pnpm build && node scripts/make-release-manifest.mjs",
        "test": "node --test \"test/**/*.test.ts\""
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.9",
        "typescript": "^5.9.3",
        "vite": "^7.3.6",
        "vue": "^3.5.22",
        "vue-tsc": "^3.1.1"
    }
}
